# ---------------------------------------------------------------
# Hydra.AI web: copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------

# Turso (libsql). Create with: turso db create hydra-web
# Local dev can use a file DB instead: TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=libsql://hydra-web-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# HMAC secret for signing app tokens. At least 32 random characters.
# Generate: openssl rand -base64 48
AUTH_SECRET=

# Admin dashboard basic auth (required to access /admin). Unset = admin closed.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Public base URL of the R2 bucket that serves GGUF files (custom domain or r2.dev)
# TODO: set once the bucket and public domain exist in Cloudflare.
R2_PUBLIC_BASE_URL=https://models.example.com

# Public site URL (absolute links, canonical tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the Google Play RTDN webhook (?key=...). Replace with Pub/Sub OIDC verification.
PLAY_RTDN_SECRET=

# Google Play Billing (server-side purchase verification)
# TODO(play): create a Google Cloud service account, link it in Play Console
# (Users and permissions) with "View financial data" and "Manage orders and subscriptions".
GOOGLE_PLAY_PACKAGE_NAME=com.zenlink.hydra
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# Private key with literal \n sequences, from the service account JSON "private_key" field.
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=

# Local/CI: skip real Google Play API (no service account needed)
USE_MOCK_PLAY=true

# Optional: only if you wire a web-side Sentry project (Android uses BuildConfig/local props)
# SENTRY_DSN=
